# HiveMind configuration — copy to .env and fill in. Safe defaults are shown; the ones marked
# REQUIRED-IN-PROD must be set for a real deployment.

# --- runtime ---
ENV=production                 # production | development (development = plain logs, relaxed checks)
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- Neo4j (the single store) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j # REQUIRED-IN-PROD: set a strong password

# --- security / secrets ---
ADMIN_TOKEN=                   # operator break-glass; empty = /admin API disabled (use org_admin)
SECRET_MASTER_KEY=             # Fernet key for the vault; empty = auto-generated + persisted on /data
HIVE_ORG_NAME=HiveMind         # name of the org created by the first self-registration

# --- Microsoft Entra (Azure AD) SSO — optional; leave blank to disable ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=            # else derived from PUBLIC_BASE_URL
PUBLIC_BASE_URL=               # e.g. https://hive.example.com (for OAuth redirects)
ENTRA_AUTO_PROVISION=true      # any tenant user auto-gets a member account; false = invite-only-with-SSO

# --- embeddings (local by default; no cloud) ---
EMBEDDINGS_LOCAL=true
EMBEDDINGS_BASE_URL=           # set to use an OpenAI-compatible endpoint instead of local
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_DIM=384

# --- ranking / governance / limits (sane defaults; tune per org) ---
CONSENSUS_THRESHOLD=2          # distinct votes before a chore is actionable (1 for solo orgs)
DEDUP_SIMILARITY_THRESHOLD=0.92
DEDUP_REVIEW_THRESHOLD=0.85
ATTACHMENT_MAX_MB=15
