#!/usr/bin/env bash
# Fetch a secret from the HiveMind vault for env injection:
#   export MY_KEY=$(hive-secret MY_KEY)
# Secrets are deliberately REST-only (no MCP tool) so they never enter chat context.
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: hive-secret <name>" >&2
  exit 1
fi
: "${HIVE_URL:?HIVE_URL not set}"
: "${HIVE_TOKEN:?HIVE_TOKEN not set}"

curl -sf -m 10 "$HIVE_URL/secrets/$1" \
  -H "Authorization: Bearer $HIVE_TOKEN" \
  | python3 -c 'import json, sys; print(json.load(sys.stdin)["value"])'
