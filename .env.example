# --- required ---
ADMIN_TOKEN=change-me-admin-token
NEO4J_PASSWORD=change-me-neo4j
# Fernet key for the secrets vault:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_MASTER_KEY=

# --- embeddings ---
# LOCAL BY DEFAULT: docker-compose runs the bundled `embedder` service (fastembed,
# multilingual MiniLM, 384 dims, model baked into the image — fully offline, no cloud).
# Nothing to configure. Override the model at build time with:
#   docker compose build --build-arg EMBEDDER_MODEL=<fastembed model name> embedder
# (keep EMBEDDINGS_DIM in docker-compose.yml in sync with the model's dimensions)

# --- tuning (defaults shown) ---
# CONSENSUS_THRESHOLD=2
# FRESHNESS_HALF_LIFE_DAYS=30
# STABLE_HALF_LIFE_DAYS=365
# SEMANTIC_WEIGHT=0.7
# FRESHNESS_WEIGHT=0.3
# DEDUP_SIMILARITY_THRESHOLD=0.92
