# --- required ---
ADMIN_TOKEN=change-me-admin-token
NEO4J_PASSWORD=change-me-neo4j
# Fernet key for the secrets vault:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_MASTER_KEY=

# --- embeddings (optional; OpenAI-compatible — OpenAI or Ollama both work) ---
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=sk-...
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_DIM=1536
# -- or local via Ollama:
# EMBEDDINGS_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDINGS_MODEL=nomic-embed-text
# EMBEDDINGS_DIM=768

# --- tuning (defaults shown) ---
# CONSENSUS_THRESHOLD=2
# FRESHNESS_HALF_LIFE_DAYS=30
# STABLE_HALF_LIFE_DAYS=365
# SEMANTIC_WEIGHT=0.7
# FRESHNESS_WEIGHT=0.3
# DEDUP_SIMILARITY_THRESHOLD=0.92
