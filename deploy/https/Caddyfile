{
	admin off
	# Clients connecting by IP send no SNI; serve the host's cert as the default so the
	# TLS handshake succeeds (some MCP clients connect by IP/host without SNI).
	default_sni {$NECTAR_HOST}
}

# HTTPS in front of the Nectar API — some MCP clients connect reliably over TLS where
# plain HTTP to a LAN host fails at the socket level. Self-signed via Caddy's internal CA
# (valid for NECTAR_HOST); install the root CA on client devices from /ca.crt.
# Set NECTAR_HOST to your server's hostname or IP in the environment.
https://{$NECTAR_HOST}:8643 {
	bind 0.0.0.0
	tls internal

	# Download the root CA to trust on devices (macOS/iOS/Android/Windows).
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=nectar-ca.crt"
	}

	handle {
		reverse_proxy hivemind:8000 {
			flush_interval -1
		}
	}
}
